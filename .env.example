# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# SMTP (för att skicka fakturor via mejl) — vanlig webbhotell-mejlbox,
# lösenord eller app-lösenord från cPanel/webbhotellet.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME="Lindqvist / Holmgren"
SMTP_FROM_EMAIL=

# IMAP (för att synka inkommande mejl till admin-dashboarden)
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASSWORD=

# Delad hemlighet som GitHub Actions-workflowet (.github/workflows/email-sync.yml)
# skickar med som header när den anropar /api/cron/email-sync. Måste läggas
# både här och som GitHub Actions-secret i repot.
CRON_SECRET=
